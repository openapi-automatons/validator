{
  "name": "@automatons/validator",
  "version": "1.0.186",
  "repository": "https://github.com/openapi-automatons/validator.git",
  "author": "tanmen <yt.prog@gmail.com>",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "depcheck",
    "build": "tsup && cp package.json README.md LICENSE dist",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "keywords": [
    "openapi",
    "validate",
    "validator"
  ],
  "dependencies": {
    "@hyperjump/browser": "^1",
    "@hyperjump/json-schema": "^1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.2.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "semantic-release": "^25.0.8",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
